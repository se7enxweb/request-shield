# Built into cjw-network/request-shield, read before every site's own rules:
# addresses only scanners ask for, on any PHP site. A site takes one back with
# "unblock [SCAN-BACKUP]", or all of them with "unblock @scanners"; opens one
# at some paths with "unblock [SCAN-HIDDEN] at /admin/files/** for <addresses>".
#
# The comment after each rule is its description on the active rules page.
# The expect lines below a rule are its examples: request-shield test decides
# them (what the rule refuses, and near misses it must let through).

ids SCAN required
version 2026.11.1

[SCAN-HIDDEN@1] block regex /\.(git|svn|hg|bzr|env|htpasswd|ds_store|idea|vscode)(/|$)                 # hidden files and folders: .env, .git, .htpasswd, editor settings
expect GET /.env                      404
expect GET /.git/config               404
expect GET /environment              answered   # a near miss: a page about the environment
expect GET /.well-known/security.txt  answered   # not a hidden file this rule means
[SCAN-BACKUP@1] block regex \.(bak|old|orig|save|swp|sql|sql\.gz|tar|tar\.gz|tgz|zip|7z|rar|log)$      # backups, dumps and archives: .bak, .old, .sql, .zip, .tar.gz, .log …
expect GET /backup.zip                404
expect GET /db/dump.sql.gz           404
expect GET /zip-codes                answered   # a near miss: no file extension
[SCAN-TEST@1]   block regex /(phpinfo|php_info|info|test)\.php$                                        # test and info scripts: phpinfo.php, info.php, test.php
expect GET /phpinfo.php               404
expect GET /test.php                  404
expect GET /testimonials             answered   # a near miss
[SCAN-DBTOOL@1] block regex /(vendor/phpunit|phpmyadmin|pma|adminer)(/|\.php|$)                        # database and test tools: phpMyAdmin, Adminer, PHPUnit
expect GET /phpmyadmin/              404
expect GET /adminer.php               404
expect GET /pma-conference           answered   # a near miss: pma, then more
[SCAN-CGI@1]    block regex /(cgi-bin|\.well-known/(?!acme-challenge|security\.txt|change-password))    # cgi-bin, and .well-known except certificates, security.txt and password change
expect GET /cgi-bin/status           404
expect GET /.well-known/acme-challenge/token  answered   # certificates keep working
expect GET /.well-known/change-password       answered
[SCAN-CONFIG@1] block regex /(composer\.(json|lock)|web\.config|docker-compose\.ya?ml|\.npmrc|id_(rsa|dsa|ecdsa|ed25519)(\.pub)?)$   # project and key files: composer.json, web.config, docker-compose.yml, .npmrc, id_rsa
expect GET /composer.json            404
expect GET /vendor/x/composer.lock   404
expect GET /id_rsa                    404
expect GET /composer-guide           answered   # a near miss
[SCAN-SECRETS@1] block regex /\.(?:env[._-][a-z0-9._-]+$|(?:htaccess|user\.ini|aws|azure|gcloud|ssh|docker|dockerenv|kube|netrc|pgpass|my\.cnf|s3cfg|boto|pypirc|vault-token|terraform|bash_history|gitconfig|git-credentials|envrc|cursor|claude)(?:/|$))   # copies of .env and stored keys: .env.production, .aws, .ssh, .docker, .kube, .git-credentials, .htaccess
expect GET /.env.production           404   # the copies a deploy leaves behind: .env.local, .env-prod, .env_1
expect GET /api/.env.local            404
expect GET /.aws/credentials          404   # the keys of cloud and container tools
expect GET /.docker/config.json       404
expect GET /.git-credentials          404
expect GET /.htaccess                 404
expect GET /tools/.envoy             answered   # a near miss: a name that only starts like .env
expect GET /tags/.net                answered   # a near miss: a tag that starts with a dot
expect GET /.dockerignore            answered   # a near miss: .docker, then more
expect GET /blog/aws-pricing         answered   # a near miss: no dot
[SCAN-KEYS@1]   block regex /(?:c(?:redentials?|lient[-_]secrets?)\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)|s(?:ecrets?\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)|ervice[-_]?account[a-z0-9_-]*\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)|erver\.key)|aws[-_]?(?:credentials|keys?)\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)|priv(?:ate(?:[-_]?key\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)|\.key)|key\.(?:json|ya?ml|env|pem|key|txt|ini|conf|cfg|properties|toml|xml)))$|\.(?:pem|p12|pfx|jks|keystore|ppk|kdbx|tfvars|tfstate(?:\.backup)?)$   # credential files and key stores: credentials.json, service-account.json, secrets.yml, private.key, .pem, .p12, .tfstate
expect GET /credentials.json          404
expect GET /config/service-account.json  404
expect GET /secrets.yml               404
expect GET /private.key               404
expect GET /certs/server.pem          404
expect GET /terraform.tfstate         404
expect GET /credentials-guide        answered   # a near miss: no file extension
expect GET /blog/secrets.html        answered   # a near miss: a page
expect GET /slides/quarter.key       answered   # a near miss: a Keynote file is a .key too
expect GET /downloads/root-ca.crt    answered   # a near miss: a certificate to hand out
